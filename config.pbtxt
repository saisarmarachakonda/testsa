name: "tagdet_rt"
backend: "onnxruntime"
max_batch_size: 2

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 3, 640, 480 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 18900, 7 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

default_model_filename: "rfdetr_model.onnx"
